package calls

import "strconv"
import "github.com/esrid/garage/internal/web/views"
import "time"

// CallsPage is GET /app/calls?day=YYYY-MM-DD.
//
// A read-only history: no form, no htmx, no mutation. Day navigation is plain
// links and a native date input, like the planning page.
templ CallsPage(history views.CallHistory) {
	@views.Layout("Appels — Atelier IA", "/app/calls") {
		<div class="page-header">
			<h1>Appels</h1>
			<p class="page-subtitle">
				{ views.FrenchDate(history.Day) }
				if history.Timezone != "" {
					{ " · " + history.Timezone }
				}
			</p>
		</div>
		<nav class="day-nav" aria-label="Choisir la journée">
			<a
				class="btn btn-secondary"
				href={ templ.SafeURL("/app/calls?day=" + callDayParam(history.Day.AddDate(0, 0, -1))) }
				rel="prev"
			>Jour précédent</a>
			<form class="day-picker" method="get" action="/app/calls">
				<label class="visually-hidden" for="calls-day-input">Journée</label>
				<input class="input" type="date" id="calls-day-input" name="day" value={ callDayParam(history.Day) }/>
				<button class="btn btn-secondary" type="submit">Voir</button>
			</form>
			<a
				class="btn btn-secondary"
				href={ templ.SafeURL("/app/calls?day=" + callDayParam(history.Day.AddDate(0, 0, 1))) }
				rel="next"
			>Jour suivant</a>
		</nav>
		for _, notice := range history.Notices {
			<p class="notice" role="status">{ notice }</p>
		}
		if !history.Degraded {
			@views.Panel("Appels du jour", "panel-call-history", len(history.Calls), "appels") {
				for _, call := range history.Calls {
					<li class="item">
						<time class="item-time" datetime={ call.At.Format(time.RFC3339) }>
							{ call.At.Format("15:04") }
						</time>
						<span class="item-title">
							<a href={ templ.SafeURL("/app/calls/" + call.ID) }>
								{ callerTitle(call) }
								<span class="visually-hidden">{ " — appel de " + call.At.Format("15:04") }</span>
							</a>
						</span>
						<span class={ "badge", views.BadgeTone(call.Outcome) }>{ views.StatusLabel(call.Outcome) }</span>
						<span class="item-detail">
							{ views.FormatDuration(call.Duration) }
							if call.Summary != "" {
								{ " — " + call.Summary }
							}
						</span>
					</li>
				}
			}
		}
	}
}

// CallPage is GET /app/calls/{id}: one call, its provider summary and the
// transcript.
templ CallPage(call views.CallDetail) {
	@views.Layout("Appel — Atelier IA", "/app/calls") {
		<div class="page-header">
			<h1>{ callerTitle(call.CallSummary) }</h1>
			<p class="page-subtitle">
				{ views.FrenchDate(call.At) + " à " + call.At.Format("15:04") }
				{ " · " + views.FormatDuration(call.Duration) }
			</p>
			<a class="btn btn-secondary page-action" href={ templ.SafeURL("/app/calls?day=" + callDayParam(call.At)) }>
				Retour aux appels
			</a>
		</div>
		<dl class="call-facts">
			<div>
				<dt>Numéro</dt>
				<dd>{ views.OrDash(call.Phone) }</dd>
			</div>
			<div>
				<dt>Résultat</dt>
				<dd><span class={ "badge", views.BadgeTone(call.Outcome) }>{ views.StatusLabel(call.Outcome) }</span></dd>
			</div>
			<div>
				<dt>Statut fournisseur</dt>
				<dd>{ views.OrDash(call.Status) }</dd>
			</div>
		</dl>
		<section class="panel call-summary" aria-labelledby="call-summary-title">
			<div class="panel-header">
				<h2 class="panel-title" id="call-summary-title">Résumé</h2>
			</div>
			<div class="panel-body">
				if call.Summary != "" {
					<p class="site-text">{ call.Summary }</p>
					// Said plainly: this sentence was written by the assistant from the
					// call, not validated by the garage (F14 stores it as provider
					// information, not business truth).
					<p class="site-note">Résumé produit par l'assistant, non vérifié.</p>
				} else {
					<p class="empty">Aucun résumé pour cet appel.</p>
				}
			</div>
		</section>
		<section class="panel call-transcript" aria-labelledby="call-transcript-title">
			<div class="panel-header">
				<h2 class="panel-title" id="call-transcript-title">Transcription</h2>
				<span class="panel-count">
					{ strconv.Itoa(len(call.Turns)) }
					<span class="visually-hidden"> tours de parole</span>
				</span>
			</div>
			<div class="panel-body">
				if len(call.Turns) == 0 {
					<p class="empty">Aucune transcription enregistrée.</p>
				} else {
					<ol class="turn-list">
						for _, turn := range call.Turns {
							<li class="turn">
								<p class="turn-speaker">
									{ turnRole(turn.Role) }
									if offset := turnOffset(turn.At); offset != "" {
										<span class="turn-offset">{ offset }</span>
									}
								</p>
								<p class="turn-text">{ turn.Text }</p>
							</li>
						}
					</ol>
				}
			</div>
		</section>
	}
}

// CallProblemPage renders the two ways a single call fails to show up. They get
// the same shape and different words on purpose: "introuvable" and "indisponible"
// are different facts, and using one for the other tells the operator something
// untrue about their data.
templ CallProblemPage(title string, message string) {
	@views.Layout(title + " — Atelier IA", "/app/calls") {
		<div class="page-header">
			<h1>{ title }</h1>
		</div>
		<p class="site-text">{ message }</p>
		<div class="cta-row">
			<a class="btn btn-secondary" href="/app/calls">Retour aux appels</a>
		</div>
	}
}
