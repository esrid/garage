package views

// The public pages. Copy rules that apply to every line below:
//   - short sentences, the vocabulary of a workshop, no marketing superlative;
//   - no figure, no reference and no testimonial that cannot be checked today,
//     so nothing here claims a customer we do not have;
//   - anything the founder still has to supply is marked [À VALIDER] on the page
//     itself, not hidden in a comment.

templ siteHero(title string, lead string) {
	<section class="hero">
		<h1 class="hero-title">{ title }</h1>
		<p class="lead">{ lead }</p>
		{ children... }
	</section>
}

templ siteSection(heading string) {
	<section class="site-section">
		<h2 class="section-title">{ heading }</h2>
		{ children... }
	</section>
}

templ siteCard(title string, text string) {
	<div class="panel site-card">
		<h3 class="site-card-title">{ title }</h3>
		<p class="site-card-text">{ text }</p>
	</div>
}

templ siteBullets(items []string) {
	<ul class="site-list">
		for _, item := range items {
			<li>{ item }</li>
		}
	</ul>
}

// sitePlaceholder marks a fact only the founder can supply. It renders visibly:
// a placeholder nobody sees is a placeholder that ships to production.
templ sitePlaceholder(what string) {
	<p class="placeholder"><strong>[À VALIDER]</strong> { what }</p>
}

templ siteCTA() {
	<div class="cta-row">
		<a class="btn" href="/demo">Voir la démo</a>
		<a class="btn btn-secondary" href="/tarifs">Voir les tarifs</a>
	</div>
}

templ SiteHome() {
	@siteHero(
		"Votre atelier ne rate plus un appel.",
		"L'assistant décroche, reconnaît le client et pose le rendez-vous. Vous restez sur le pont.",
	) {
		@siteCTA()
	}
	@siteSection("Pendant l'appel") {
		<div class="card-grid">
			@siteCard("Le client est reconnu", "Son numéro ouvre sa fiche : véhicule, dernier passage, demandes en cours.")
			@siteCard("La plaque est confirmée", "L'assistant la répète et la fait valider. Il ne la devine jamais.")
			@siteCard("La demande est qualifiée", "Vidange, freins, bruit au démarrage : le motif est noté, pas diagnostiqué.")
			@siteCard("Le créneau est réel", "Il lit votre planning. Il ne propose que ce qui est libre.")
			@siteCard("Le RDV est posé", "Créer, déplacer, annuler. Le planning reste la seule vérité.")
			@siteCard("L'humain reprend la main", "Hors périmètre : transfert vers vous, avec le contexte de l'appel.")
		</div>
	}
	@siteSection("Ce qu'il ne fait jamais") {
		<div class="card-grid">
			@siteCard("Inventer un prix", "Un tarif que vous n'avez pas validé n'est pas annoncé.")
			@siteCard("Poser un diagnostic", "Il qualifie la panne. Le mécanicien décide.")
			@siteCard("Confirmer dans le vide", "Le rendez-vous est annoncé confirmé après son enregistrement, jamais avant.")
		</div>
	}
	@siteSection("Après l'appel") {
		<p class="site-text">Chaque appel laisse une trace utilisable le lendemain.</p>
		@siteBullets([]string{
			"Transcript et résumé de l'échange.",
			"Actions réellement exécutées.",
			"Rendez-vous au planning de l'atelier.",
			"Demandes de rappel et de devis à traiter.",
			"Dashboard du jour : appels, rendez-vous, à traiter.",
			"Minutes consommées, par mois et par appel.",
		})
	}
	@siteSection("Prêt à écouter ?") {
		@siteCTA()
	}
}

templ SiteFeatures() {
	@siteHero(
		"Ce que l'assistant fait, précisément.",
		"Rien de plus, rien d'inventé. Chaque réponse vient d'une donnée que vous avez validée.",
	)
	@siteSection("Au téléphone") {
		@siteBullets([]string{
			"Répond aux appels, jour et nuit, sans mise en attente.",
			"Identifie le client par son numéro quand il est connu.",
			"Collecte et fait confirmer la plaque d'immatriculation.",
			"Qualifie la demande : prestation, symptôme, urgence.",
			"Donne horaires, adresse et prestations que vous avez saisis.",
			"Transfère à un humain sur demande ou hors périmètre.",
		})
	}
	@siteSection("Au planning") {
		@siteBullets([]string{
			"Propose des créneaux issus de vos ouvertures réelles.",
			"Prend, déplace et annule un rendez-vous.",
			"Vérifie la disponibilité une seconde fois avant de confirmer.",
			"Refuse de doubler un créneau déjà pris.",
			"Donne le statut d'une intervention depuis la fiche, jamais de mémoire.",
		})
	}
	@siteSection("Au bureau") {
		@siteBullets([]string{
			"Fiches client et véhicule tenues à jour à chaque appel.",
			"Demandes de rappel et de devis en file, avec le motif.",
			"Transcript, résumé et actions exécutées pour chaque appel.",
			"Dashboard du jour : ce qui est arrivé, ce qui reste à traiter.",
			"Consommation en minutes, avec alerte avant la fin du quota.",
		})
	}
	@siteSection("Vos données restent les vôtres") {
		@siteBullets([]string{
			"Un atelier ne voit jamais les données d'un autre.",
			"Aucune donnée récupérée automatiquement ne devient vérité sans votre validation.",
			"Hébergement européen.",
		})
		@sitePlaceholder("Nom et localisation exacte de l'hébergeur à confirmer avant publication.")
	}
	@siteSection("Voir en vrai") {
		@siteCTA()
	}
}

// Prices, quotas and usage alerts below come from the PRD (§1 and §5, version 3
// du 30 juillet 2026): 349 €/750 min and 599 €/1 750 min, alerts at 70, 85 and
// 100 %. They are the founder's pilot hypotheses, so the page says so.
templ SitePricing() {
	@siteHero(
		"Deux offres. Pas d'illimité.",
		"Prix hors taxes, par mois et par atelier. Les minutes de voix sont incluses dans l'offre.",
	)
	@siteSection("Les offres") {
		<div class="price-grid">
			<div class="panel price">
				<h3 class="price-name">Atelier</h3>
				<p class="price-amount">349 € <span class="price-period">HT / mois</span></p>
				<p class="price-quota">750 minutes incluses</p>
				<p class="site-card-text">Garage indépendant ou petit atelier.</p>
			</div>
			<div class="panel price">
				<h3 class="price-name">Atelier Pro</h3>
				<p class="price-amount">599 € <span class="price-period">HT / mois</span></p>
				<p class="price-quota">1 750 minutes incluses</p>
				<p class="site-card-text">Atelier plus actif, appels simultanés, intégration métier prioritaire.</p>
			</div>
		</div>
		@sitePlaceholder("Tarifs pilotes : à confirmer par le fondateur avant l'ouverture commerciale.")
	}
	@siteSection("Compris dans les deux offres") {
		@siteBullets([]string{
			"Appels répondus et qualifiés.",
			"Fiches client et véhicule.",
			"Rendez-vous créés, déplacés, annulés.",
			"Transfert vers un humain.",
			"Transcript, résumé et dashboard du jour.",
		})
	}
	@siteSection("Les minutes") {
		@siteBullets([]string{
			"Vous êtes averti à 70 %, 85 % et 100 % du quota.",
			"Le dépassement est facturé ou vous fait monter d'offre.",
			"Aucun forfait illimité : une minute a un coût, nous le disons.",
		})
	}
	@siteSection("Commencer") {
		// Not @siteCTA(): its second button points at this page.
		<div class="cta-row">
			<a class="btn" href="/demo">Voir la démo</a>
			<a class="btn btn-secondary" href="/contact">Nous joindre</a>
		</div>
	}
}

templ SiteWorkshops() {
	@siteHero(
		"Pensé pour les garages, pas pour les entreprises en général.",
		"Le vocabulaire est le vôtre : plaque, révision, vidange, embrayage, diagnostic, ordre de réparation.",
	)
	@siteSection("À qui ça parle") {
		@siteBullets([]string{
			"Garage indépendant ou atelier de petite à moyenne taille.",
			"Assez d'appels pour que le téléphone coupe le travail.",
			"Un dirigeant ou un chef d'atelier qui décide vite.",
			"Martinique d'abord : horaires, numéros et fuseau locaux.",
		})
	}
	@siteSection("Ce que ce n'est pas") {
		@siteBullets([]string{
			"Pas un logiciel de gestion de garage à remplacer le vôtre.",
			"Pas de facturation, pas de stock de pièces.",
			"Pas de diagnostic mécanique automatique.",
			"Pas un standard qui met en attente pour rien.",
		})
	}
	@siteSection("Une journée typique") {
		@siteBullets([]string{
			"7 h : deux appels pendant l'ouverture, deux rendez-vous posés.",
			"11 h : un client demande un devis embrayage. La demande part en rappel.",
			"14 h : un appel hors périmètre. Transfert, avec le motif déjà noté.",
			"17 h : le dashboard résume la journée.",
		})
		<p class="site-note">Exemple de scénario, pas une mesure client.</p>
	}
	@siteSection("Écouter l'assistant") {
		@siteCTA()
	}
}

templ SiteDemo() {
	@siteHero(
		"Une démo, c'est un appel.",
		"Vous appelez un numéro de test, vous jouez le client, vous écoutez ce qui se passe.",
	)
	@siteSection("Comment ça se passe") {
		<ol class="site-steps">
			<li>Nous configurons un numéro de test avec vos horaires et deux prestations.</li>
			<li>Vous appelez et demandez un rendez-vous, comme un client pressé.</li>
			<li>Vous regardez le rendez-vous arriver dans le planning, puis le résumé de l'appel.</li>
		</ol>
		<p class="site-text">Comptez quinze minutes. Aucune installation chez vous.</p>
	}
	@siteSection("Demander la démo") {
		@sitePlaceholder("Numéro de démo et adresse de contact à renseigner avant mise en ligne.")
		<p class="site-text">En attendant, la page contact liste les moyens de nous joindre.</p>
		<div class="cta-row">
			<a class="btn" href="/contact">Aller au contact</a>
		</div>
	}
}

templ SiteContact() {
	@siteHero(
		"Parler à quelqu'un.",
		"Un interlocuteur unique, qui connaît le produit et l'atelier.",
	)
	@siteSection("Nous joindre") {
		@sitePlaceholder("Téléphone, adresse e-mail et horaires de réponse à renseigner par le fondateur.")
		<p class="site-text">
			Aucun formulaire pour l'instant : il n'enverrait rien. Il arrivera avec la
			boîte d'envoi.
		</p>
	}
	@siteSection("Ce qu'il est utile de préparer") {
		@siteBullets([]string{
			"Vos horaires d'ouverture.",
			"Deux ou trois prestations courantes et leur durée.",
			"Le nombre d'appels reçus un jour normal.",
		})
	}
}

// The four legal pages exist because the footer links to them and a footer must
// never point at a 404. Their content is a skeleton: company identity, hosting
// and contractual terms are facts, and an invented legal notice is worse than an
// empty one. Each block says what is missing.
templ SiteLegalNotice() {
	@siteHero("Mentions légales", "Informations sur l'éditeur du site et son hébergeur.")
	@siteSection("Éditeur") {
		@sitePlaceholder("Dénomination, forme juridique, SIREN/SIRET, adresse du siège, responsable de la publication.")
	}
	@siteSection("Hébergeur") {
		@sitePlaceholder("Nom, adresse et téléphone de l'hébergeur du site.")
	}
	@siteSection("Propriété intellectuelle") {
		<p class="site-text">
			Les contenus de ce site sont protégés. Toute reproduction sans accord
			écrit est interdite.
		</p>
	}
}

templ SitePrivacy() {
	@siteHero("Politique de confidentialité", "Quelles données nous traitons, pourquoi, et combien de temps.")
	@siteSection("Ce que nous traitons") {
		@siteBullets([]string{
			"Les appels reçus par l'assistant : enregistrement, transcript et résumé.",
			"Les fiches client et véhicule saisies par l'atelier ou collectées pendant l'appel.",
			"Les rendez-vous et les demandes de rappel.",
		})
	}
	@siteSection("Pourquoi") {
		<p class="site-text">
			Pour répondre aux appels de l'atelier, poser des rendez-vous et lui
			rendre compte. Aucune revente, aucune publicité.
		</p>
	}
	@siteSection("Durées, base légale et droits") {
		@sitePlaceholder("Durées de conservation, base légale, sous-traitants, coordonnées pour exercer vos droits et adresse du délégué à la protection des données.")
	}
	@siteSection("Traceurs") {
		<p class="site-text">
			Ce site n'utilise aucun traceur publicitaire. Si cela change, un
			bandeau de consentement apparaîtra avant tout dépôt.
		</p>
	}
}

templ SiteTermsOfSale() {
	@siteHero("Conditions générales de vente", "Ce que couvre l'abonnement et comment il se termine.")
	@siteSection("Objet, prix et durée") {
		@sitePlaceholder("Prestations couvertes, prix, quotas, facturation du dépassement, durée d'engagement, résiliation, droit applicable.")
	}
	@siteSection("Ce qui est déjà tranché") {
		@siteBullets([]string{
			"Prix hors taxes, par atelier et par mois.",
			"Quota de minutes inclus, sans forfait illimité.",
			"Dépassement facturé ou montée d'offre, au choix du client.",
		})
	}
}

templ SiteTermsOfUse() {
	@siteHero("Conditions générales d'utilisation", "Les règles d'usage du service.")
	@siteSection("Usage du service") {
		@siteBullets([]string{
			"L'assistant répond au nom de l'atelier et pour son activité.",
			"L'atelier reste responsable des informations qu'il fait dire à l'assistant.",
			"L'assistant ne pose pas de diagnostic mécanique et n'annonce aucun prix non validé.",
		})
	}
	@siteSection("Comptes, disponibilité et responsabilité") {
		@sitePlaceholder("Création de compte, sécurité des accès, engagement de disponibilité, limites de responsabilité, suspension.")
	}
}
