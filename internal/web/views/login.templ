package views

// LoginPage is GET /login. It posts to POST /auth/login, frozen in
// docs/contracts/F09-authentication.md: two fields, form-urlencoded, no
// JavaScript, no tenant_id.
//
// The public shell, not the app shell: nobody is signed in on this page, and the
// app navigation would point at routes that answer 401.
templ LoginPage(meta SiteMeta, login Login) {
	@SiteLayout(meta, loginForm(login))
}

templ loginForm(login Login) {
	@siteHero("Connexion", "L'accès à l'atelier est réservé à votre équipe.")
	<section class="site-section login-section">
		if message := login.LoginMessage(); message != "" {
			// role="alert" and not a plain paragraph: after a failed submit the
			// message is the only thing that changed on the page, and a screen
			// reader user needs to hear it without hunting for it.
			<p class="notice" role="alert">{ message }</p>
		}
		<form class="login-form" method="post" action="/auth/login">
			<div class="field">
				<label class="field-label" for="login-email">Email</label>
				<input
					class="input"
					type="email"
					id="login-email"
					name="email"
					autocomplete="username"
					required
					autofocus
					spellcheck="false"
				/>
			</div>
			<div class="field">
				<label class="field-label" for="login-password">Mot de passe</label>
				// current-password, not password: the browser and the password
				// manager must offer the saved credential, not propose a new one.
				<input
					class="input"
					type="password"
					id="login-password"
					name="password"
					autocomplete="current-password"
					required
				/>
			</div>
			if login.Next != "" {
				// Carried for the day POST /auth/login honours it (MT-07). The F09
				// handler reads only email and password today, so this field is inert
				// and harmless: it never becomes a redirect the caller controls.
				<input type="hidden" name="next" value={ login.Next }/>
			}
			<div class="form-actions">
				<button class="btn" type="submit">Se connecter</button>
			</div>
		</form>
		<p class="site-note">
			Mot de passe oublié : contactez la personne qui gère votre atelier.
			La réinitialisation en libre-service n'existe pas encore.
		</p>
	</section>
}
