// Package views holds the templ components rendered by the HTTP handlers.
// Components receive plain data and never reach for a database or a service:
// everything they display is passed in by the handler.
package views

// Layout is the shell every application page renders inside.
//
// currentPath drives aria-current on the navigation, so the accessible state
// and the visual highlight come from the same value and cannot disagree.
//
// The nav intentionally lists only routes that exist. Links are added as pages
// ship, so the shell never points at a 404.
//
// One stylesheet: app.css @imports tokens.css, so the whole CSS directory has
// to be served (see assets/src/css/README.md).
templ Layout(title string, currentPath string) {
	<!DOCTYPE html>
	<html lang="fr">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
		</head>
		<body>
			<a class="skip-link" href="#main">Aller au contenu</a>
			<header class="app-header">
				<a class="app-brand" href="/app">Atelier IA</a>
				<nav class="app-nav" aria-label="Navigation principale">
					@navLink("/app", "Aujourd'hui", currentPath)
				</nav>
			</header>
			<main class="app-main" id="main">
				{ children... }
			</main>
		</body>
	</html>
}

templ navLink(href string, label string, currentPath string) {
	if href == currentPath {
		<a class="app-nav-link" href={ templ.SafeURL(href) } aria-current="page">{ label }</a>
	} else {
		<a class="app-nav-link" href={ templ.SafeURL(href) }>{ label }</a>
	}
}
